---
interface Props {
  name: 'phone' | 'whatsapp' | 'menu' | 'close' | 'arrow' | 'chevron' | 'electrical' | 'plumbing' | 'emergency' | 'location' | 'clock' | 'home' | 'tools' | 'fan' | 'light' | 'plug' | 'tap' | 'pipe' | 'shield' | 'briefcase' | 'plus' | 'minus';
  size?: number;
  className?: string;
}

const { name, size = 24, className = '' } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={`icon icon-${name} ${className}`} aria-hidden="true">
  {name === 'phone' && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}
  {name === 'whatsapp' && (
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  )}
  {name === 'menu' && (
    <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
  )}
  {name === 'close' && (
    <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
  )}
  {name === 'chevron' && (
    <polyline points="6 9 12 15 18 9" />
  )}
  {name === 'briefcase' && (
    <><rect x="2" y="7" width="20" height="14" rx="2" ry="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /></>
  )}
  {name === 'clock' && (
    <><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></>
  )}
  {name === 'location' && (
    <><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></>
  )}
  {name === 'tools' && (
    <><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></>
  )}
  {name === 'fan' && (
    <><path d="M10.827 16.379a6.082 6.082 0 0 1-8.618-7.002l5.412 1.45a6.082 6.082 0 0 1 7.002-8.618l-1.45 5.412a6.082 6.082 0 0 1 8.618 7.002l-5.412-1.45a6.082 6.082 0 0 1-7.002 8.618l1.45-5.412Z" /><circle cx="12" cy="12" r="2" /></>
  )}
  {name === 'light' && (
    <><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></>
  )}
  {name === 'plug' && (
    <><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></>
  )}
  {name === 'shield' && (
    <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></>
  )}
  {name === 'tap' && (
    <><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></>
  )}
  {name === 'pipe' && (
    <><path d="M4 10v4h16v-4z"/><path d="M8 8v8"/><path d="M16 8v8"/></>
  )}
  {name === 'shower' && (
    <><path d="M12 6V3h4"/><path d="M16 10a4 4 0 0 0-8 0"/><path d="M9 14h.01"/><path d="M15 14h.01"/><path d="M12 17h.01"/><path d="M9 20h.01"/><path d="M15 20h.01"/></>
  )}
  {name === 'toilet' && (
    <><path d="M9 6h6"/><path d="M10 2v4"/><path d="M14 2v4"/><path d="M4 14h16v-2H4v2z"/><path d="M5 14v4a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-4"/></>
  )}
  {name === 'sink' && (
    <><path d="M4 10v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10"/><path d="M2 10h20"/><path d="M12 2v2"/><path d="M10 4h4"/><circle cx="12" cy="14" r="1"/></>
  )}
  {name === 'plus' && (
    <><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></>
  )}
  {name === 'minus' && (
    <><line x1="5" y1="12" x2="19" y2="12" /></>
  )}
</svg>
