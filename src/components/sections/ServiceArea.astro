---
import Icon from '../common/Icon.astro';
import Button from '../common/Button.astro';
import { BUSINESS_INFO, getWhatsAppLink } from '../../utils/constants';

interface Props {
  t: Record<string, string>;
}

const { t } = Astro.props;
---

<section id="service-area" class="service-area-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow">{t['service_area.eyebrow']}</span>
      <h2 class="heading-2">{t['service_area.title']}</h2>
      <p class="section-desc">{t['service_area.desc']}</p>
    </div>

    <div class="service-area-content">
      <div class="service-area-info">
        <ul class="info-list" role="list">
          <li class="info-item">
            <div class="info-icon">
              <Icon name="location" size={24} />
            </div>
            <div class="info-text">
              <strong>{t['service_area.base']}</strong>
              <span>{t['service_area.base_val']}</span>
            </div>
          </li>
          <li class="info-item">
            <div class="info-icon">
              <Icon name="shield" size={24} />
            </div>
            <div class="info-text">
              <strong>{t['service_area.coverage']}</strong>
              <span>{t['service_area.coverage_val']}</span>
            </div>
          </li>
          <li class="info-item">
            <div class="info-icon">
              <Icon name="tools" size={24} />
            </div>
            <div class="info-text">
              <strong>{t['service_area.services']}</strong>
              <span>{t['service_area.services_val']}</span>
            </div>
          </li>
          <li class="info-item">
            <div class="info-icon">
              <Icon name="clock" size={24} />
            </div>
            <div class="info-text">
              <strong>{t['service_area.emergency']}</strong>
              <span>{t['service_area.emergency_val']}</span>
            </div>
          </li>
        </ul>
        
        <div class="coverage-note">
          <p><strong>{t['service_area.map.villages']}:</strong> {t['service_area.map.availability']}</p>
        </div>
      </div>

      <div class="service-area-visual">
        <div class="map-illustration">
          <div class="map-circle"></div>
          <div class="map-circle-inner"></div>
          
          <div class="map-pin">
            <Icon name="location" size={32} className="pin-icon" />
            <div class="pin-pulse"></div>
            <div class="pin-label">{t['service_area.map.ravulapalem']}</div>
          </div>
          
          <div class="map-radius-label">
            <span>{t['service_area.map.50km']}</span>
          </div>
        </div>
        <p class="visual-caption">{t['service_area.map.approx']}</p>
      </div>
    </div>

    <div class="service-area-cta text-center">
      <h3 class="heading-3">{t['service_area.cta.title']}</h3>
      <p>{t['service_area.cta.desc']}</p>
      
      <div class="cta-actions">
        <Button href={BUSINESS_INFO.phoneLink} variant="primary">
          <Icon name="phone" size={20} />
          {t['cta.call_now']}
        </Button>
        <Button href={getWhatsAppLink()} variant="accent" className="wa-btn">
          <Icon name="whatsapp" size={20} />
          {t['cta.whatsapp']}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .service-area-section {
    padding: var(--spacing-xxl) 0;
    background-color: var(--color-background-alt);
    position: relative;
    overflow: hidden;
  }
  
  .section-header {
    margin-bottom: var(--spacing-xl);
    max-width: 800px;
    margin-inline: auto;
  }
  
  .section-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    margin-top: var(--spacing-sm);
  }
  
  .service-area-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
    margin-bottom: var(--spacing-xxl);
  }
  
  @media (min-width: 992px) {
    .service-area-content {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--spacing-xxl);
    }
  }
  
  /* Info List Styles */
  .info-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }
  
  .info-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    background-color: var(--color-white);
    padding: var(--spacing-md);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }
  
  .info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }
  
  .info-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .info-text strong {
    color: var(--color-text-main);
    font-size: var(--font-size-md);
  }
  
  .info-text span {
    color: var(--color-text-light);
    font-size: var(--font-size-base);
  }
  
  .coverage-note {
    background-color: var(--color-white);
    padding: var(--spacing-md);
    border-left: 4px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    box-shadow: var(--shadow-sm);
  }
  
  .coverage-note p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
  
  .coverage-note strong {
    color: var(--color-text-main);
  }
  
  /* Visual Styles */
  .service-area-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  
  .map-illustration {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }
  
  .map-circle {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: rgba(10, 37, 64, 0.05);
    border: 2px dashed var(--color-primary-light);
    animation: pulse-ring 4s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }
  
  .map-circle-inner {
    position: absolute;
    width: 50%;
    height: 50%;
    border-radius: 50%;
    background-color: rgba(10, 37, 64, 0.08);
  }
  
  .map-pin {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .pin-icon {
    color: var(--color-primary);
    filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));
  }
  
  .pin-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 24px;
    height: 24px;
    background-color: var(--color-primary);
    border-radius: 50%;
    opacity: 0.2;
    animation: pulse-dot 2s ease-in-out infinite;
    z-index: -1;
  }
  
  .pin-label {
    margin-top: var(--spacing-xs);
    background-color: var(--color-white);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 700;
    color: var(--color-text-main);
    box-shadow: var(--shadow-md);
    white-space: nowrap;
  }
  
  .map-radius-label {
    position: absolute;
    top: 15%;
    right: 15%;
    background-color: var(--color-accent);
    color: var(--color-primary);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: 700;
    box-shadow: var(--shadow-sm);
    z-index: 5;
  }
  
  .visual-caption {
    margin-top: var(--spacing-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    font-style: italic;
    text-align: center;
  }
  
  /* CTA Styles */
  .service-area-cta {
    background-color: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    max-width: 800px;
    margin: 0 auto;
    border-top: 4px solid var(--color-primary);
  }
  
  .service-area-cta h3 {
    margin-bottom: var(--spacing-xs);
  }
  
  .service-area-cta p {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-lg);
  }
  
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    justify-content: center;
  }
  
  .wa-btn {
    background-color: #25D366;
    color: var(--color-white);
  }
  
  .wa-btn:hover {
    background-color: #128C7E;
    color: var(--color-white);
  }
  
  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
    }
  }
  
  @keyframes pulse-ring {
    0% {
      transform: scale(0.95);
      opacity: 0.5;
    }
    50% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(0.95);
      opacity: 0.5;
    }
  }
  
  @keyframes pulse-dot {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.4;
    }
    50% {
      transform: translate(-50%, -50%) scale(2);
      opacity: 0;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
  }
</style>
