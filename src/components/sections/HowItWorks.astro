---
import Icon from '../common/Icon.astro';
import Button from '../common/Button.astro';
import { BUSINESS_INFO, getWhatsAppLink } from '../../utils/constants';

interface Props {
  t: Record<string, string>;
}

const { t } = Astro.props;
---

<section id="how-it-works" class="how-it-works-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="eyebrow">{t['how.eyebrow']}</span>
      <h2 class="heading-2">{t['how.title']}</h2>
      <p class="section-desc">{t['how.desc']}</p>
    </div>

    <div class="steps-container">
      <div class="steps-line"></div>
      
      <div class="step">
        <div class="step-number">01</div>
        <div class="step-icon">
          <Icon name="phone" size={28} />
        </div>
        <h3 class="heading-4">{t['how.s1_title']}</h3>
        <p>{t['how.s1_desc']}</p>
      </div>
      
      <div class="step-connector">
        <Icon name="chevron" size={24} className="down-arrow" />
      </div>

      <div class="step">
        <div class="step-number">02</div>
        <div class="step-icon">
          <Icon name="briefcase" size={28} />
        </div>
        <h3 class="heading-4">{t['how.s2_title']}</h3>
        <p>{t['how.s2_desc']}</p>
      </div>
      
      <div class="step-connector">
        <Icon name="chevron" size={24} className="down-arrow" />
      </div>

      <div class="step">
        <div class="step-number">03</div>
        <div class="step-icon">
          <Icon name="tools" size={28} />
        </div>
        <h3 class="heading-4">{t['how.s3_title']}</h3>
        <p>{t['how.s3_desc']}</p>
      </div>
    </div>

    <div class="cta-actions text-center">
      <Button href={BUSINESS_INFO.phoneLink} variant="primary">
        <Icon name="phone" size={20} />
        {t['cta.call_now']}
      </Button>
      <Button href={getWhatsAppLink()} variant="accent" className="wa-btn">
        <Icon name="whatsapp" size={20} />
        {t['cta.whatsapp']}
      </Button>
    </div>
  </div>
</section>

<style>
  .how-it-works-section {
    padding: var(--spacing-xxl) 0;
    background-color: var(--color-background-alt);
    position: relative;
  }
  
  .section-header {
    margin-bottom: var(--spacing-xl);
    max-width: 800px;
    margin-inline: auto;
  }
  
  .section-desc {
    font-size: var(--font-size-lg);
    color: var(--color-text-light);
    margin-top: var(--spacing-sm);
  }
  
  .steps-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    max-width: 1000px;
    margin: 0 auto var(--spacing-xl);
    gap: var(--spacing-md);
  }
  
  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background-color: var(--color-white);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 320px;
    border-top: 4px solid var(--color-primary);
  }
  
  .step-number {
    position: absolute;
    top: -16px;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-weight: 800;
    font-size: var(--font-size-sm);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }
  
  .step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background-color: rgba(14, 165, 233, 0.1);
    color: var(--color-primary-light);
    border-radius: var(--radius-full);
    margin-bottom: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }
  
  .step h3 {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text-main);
  }
  
  .step p {
    color: var(--color-text-light);
    margin: 0;
  }
  
  .step-connector {
    color: var(--color-text-light);
    display: flex;
    justify-content: center;
    padding: var(--spacing-sm) 0;
  }
  
  .down-arrow {
    transform: rotate(90deg);
    opacity: 0.5;
  }
  
  .steps-line {
    display: none;
  }
  
  @media (min-width: 768px) {
    .steps-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: stretch;
      gap: var(--spacing-lg);
    }
    
    .step {
      max-width: none;
      flex: 1;
    }
    
    .step-connector {
      display: none;
    }
    
    .steps-line {
      display: block;
      position: absolute;
      top: 50%;
      left: 10%;
      right: 10%;
      height: 2px;
      background-color: rgba(14, 165, 233, 0.2);
      z-index: 1;
      transform: translateY(-50%);
    }
  }
  
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    justify-content: center;
    margin-top: var(--spacing-xl);
  }
  
  .wa-btn {
    background-color: #25D366;
    color: var(--color-white);
  }
  
  .wa-btn:hover {
    background-color: #128C7E;
    color: var(--color-white);
  }
  
  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
    }
  }
</style>
