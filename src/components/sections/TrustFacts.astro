---
import Icon from '../common/Icon.astro';

interface Props {
  t: Record<string, string>;
}

const { t } = Astro.props;
---
<section class="trust-facts-section">
  <div class="container">
    <div class="trust-facts-grid">
      
      <div class="trust-fact-card">
        <div class="fact-icon-wrapper experience-icon">
          <Icon name="briefcase" size={28} />
        </div>
        <p class="fact-text">{t['trust.exp']}</p>
      </div>
      
      <div class="trust-fact-card">
        <div class="fact-icon-wrapper emergency-icon">
          <Icon name="clock" size={28} />
        </div>
        <p class="fact-text">{t['trust.emergency']}</p>
      </div>
      
      <div class="trust-fact-card">
        <div class="fact-icon-wrapper location-icon">
          <Icon name="location" size={28} />
        </div>
        <p class="fact-text">{t['trust.area']}</p>
      </div>
      
      <div class="trust-fact-card">
        <div class="fact-icon-wrapper services-icon">
          <Icon name="tools" size={28} />
        </div>
        <p class="fact-text">{t['trust.services']}</p>
      </div>
      
    </div>
  </div>
</section>

<style>
  .trust-facts-section {
    background-color: var(--color-white);
    padding: var(--spacing-xl) 0;
    border-bottom: 1px solid #eee;
  }
  
  .trust-facts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }
  
  .trust-fact-card {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    background-color: var(--color-white);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid #f0f0f0;
    transition: transform var(--transition-fast);
  }
  
  .trust-fact-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  
  .fact-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  
  .experience-icon {
    background-color: rgba(11, 31, 58, 0.1);
    color: var(--color-primary);
  }
  
  .emergency-icon {
    background-color: rgba(220, 38, 38, 0.1);
    color: var(--color-emergency);
  }
  
  .location-icon {
    background-color: rgba(14, 165, 233, 0.1);
    color: var(--color-plumb);
  }
  
  .services-icon {
    background-color: rgba(255, 193, 7, 0.15);
    color: #b38600; /* Darker yellow for contrast */
  }
  
  .fact-text {
    font-weight: 700;
    font-size: var(--font-size-base);
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
  }
  
  @media (min-width: 480px) {
    .trust-facts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .trust-facts-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--spacing-lg);
    }
    
    .trust-fact-card {
      flex-direction: column;
      text-align: center;
      padding: var(--spacing-lg) var(--spacing-md);
    }
  }
</style>
